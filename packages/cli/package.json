{
  "name": "@base-attribution-os/cli",
  "version": "0.3.0",
  "description": "CLI validator for Base Builder Code attribution.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/horn111/base-attribution-os.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/horn111/base-attribution-os#readme",
  "bugs": {
    "url": "https://github.com/horn111/base-attribution-os/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "bao": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-attribution-os/core": "workspace:*",
    "@base-attribution-os/scanner": "workspace:*",
    "@base-attribution-os/wallet": "workspace:*"
  }
}
