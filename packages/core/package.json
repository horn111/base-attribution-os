{
  "name": "@base-attribution-os/core",
  "version": "0.3.1",
  "description": "Core ERC-8021 Builder Code suffix helpers for Base Attribution OS.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/horn111/base-attribution-os.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/horn111/base-attribution-os#readme",
  "bugs": {
    "url": "https://github.com/horn111/base-attribution-os/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "ox": ">=0.9.0"
  },
  "peerDependenciesMeta": {
    "ox": {
      "optional": true
    }
  }
}
